#! /bin/sh

### BEGIN INIT INFO
# Provides:		bbs-wsd
# Required-Start:	$syslog $network $remote_fs
# Required-Stop:	$syslog $network $remote_fs
# Default-Start:	2 3 4 5
# Default-Stop:		
# Short-Description:	BBS WebSocket server
### END INIT INFO

set -e

# /etc/init.d/bbs-wsd: start and stop the bbs-wsd

EXE="/opt/bbs-wsd"
CONF="/etc/bbs-wsd.toml"
PID_FILE="/home/bbs/run/bbs-wsd.pid"

test -x "$EXE" || exit 0

umask 022

if test -f /etc/default/bbs-wsd; then
    . /etc/default/bbs-wsd
fi

. /lib/lsb/init-functions

if [ -n "$2" ]; then
    BBS_WSD_OPTS="$BBS_WSD_OPTS $2"
fi

# Are we running from init?
run_by_init() {
    ([ "$previous" ] && [ "$runlevel" ]) || [ "$runlevel" = S ]
}

export PATH="${PATH:+$PATH:}/usr/sbin:/sbin"

case "$1" in
  start)
	log_daemon_msg "Starting BBS WebSocket server" "bbs-wsd" || true
	if start-stop-daemon --start --quiet --oknodo --chuid 0:0 --pidfile "$PID_FILE" --exec "$EXE" -- -f "$CONF"; then
	    log_end_msg 0 || true
	else
	    log_end_msg 1 || true
	fi
	;;
  stop)
	log_daemon_msg "Stopping BBS WebSocket server" "bbs-wsd" || true
	if start-stop-daemon --stop --quiet --oknodo --pidfile "$PID_FILE" --signal TERM --exec "$EXE"; then
	    log_end_msg 0 || true
	else
	    log_end_msg 1 || true
	fi
	;;

  reload)
	log_daemon_msg "Gracefully restarting BBS WebSocket server to reload configuration" "bbs-wsd" || true
	if start-stop-daemon --stop --signal INT --quiet --oknodo --pidfile "$PID_FILE" --exec "$EXE"; then
	    /bin/rm -f "$PID_FILE"
	    if start-stop-daemon --start --quiet --oknodo --chuid 0:0 --pidfile "$PID_FILE" --exec "$EXE" -- -f "$CONF"; then
		log_end_msg 0 || true
	    else
		log_end_msg 1 || true
	    fi
	else
	    log_end_msg 1 || true
	fi
	;;

  restart)
	log_daemon_msg "Restarting BBS WebSocket server" "bbs-wsd" || true
	start-stop-daemon --stop --quiet --oknodo --retry 30 --signal TERM --pidfile "$PID_FILE" --exec "$EXE"
	if start-stop-daemon --start --quiet --oknodo --chuid 0:0 --pidfile "$PID_FILE" --exec "$EXE" -- -f "$CONF"; then
	    log_end_msg 0 || true
	else
	    log_end_msg 1 || true
	fi
	;;

  status)
	status_of_proc -p "$PID_FILE" "$EXE" bbs-wsd && exit 0 || exit $?
	;;

  *)
	log_action_msg "Usage: /etc/init.d/bbs-wsd {start|stop|reload|restart|status}" || true
	exit 1
esac

exit 0
